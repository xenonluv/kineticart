# 키네틱 아트 플랫폼 환경변수 예시.
# 이 파일을 복사해 `.env` 로 만들고 각 값을 채우세요:  cp .env.example .env
# ⚠️ 실제 값이 든 .env 는 절대 커밋하지 마세요 (.gitignore 에 등록됨).

# ── Cloudflare Tunnel ─────────────────────────────────────────────
# 외부 노출용 터널 커넥터 토큰.
# Cloudflare Zero Trust → Networks → Tunnels → 터널 생성 시 발급되는 eyJ... 문자열.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Postgres / PostgREST ──────────────────────────────────────────
# DB 슈퍼유저 비밀번호. 임의의 강한 값 권장:  openssl rand -hex 16
POSTGRES_PASSWORD=
# PostgREST 가 DB 에 접속하는 authenticator 역할 비밀번호. 임의의 강한 값:  openssl rand -hex 16
AUTHENTICATOR_PASSWORD=

# ── Google AI (대화 Gemini + 이미지 Nano Banana) ──────────────────
# https://aistudio.google.com → Get API key.
# ★ 이미지 생성(Nano Banana)은 "결제(billing)가 활성화된 프로젝트"의 키여야 작동합니다.
#   (대화 텍스트는 무료 티어로 가능)
GOOGLE_API_KEY=

# ── 웹앱 로그인 (비밀번호 게이트) ─────────────────────────────────
# 사이트 접속 비밀번호 (원하는 값으로 지정)
SITE_PASSWORD=
# 로그인 성공 시 브라우저 쿠키에 저장·검증되는 토큰. 임의의 랜덤 값:  openssl rand -hex 24
AUTH_TOKEN=

# ── (Phase 5, 예정) Tripo 3D ──────────────────────────────────────
# https://www.tripo3d.ai 개발자 API 키. 보통 tsk_ 로 시작.
TRIPO_API_KEY=
